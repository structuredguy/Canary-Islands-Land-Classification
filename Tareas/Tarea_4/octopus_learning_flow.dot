digraph OctopusLearningBreakdown {
    rankdir=TB;
    bgcolor="white";
    pad="0.25";
    nodesep="0.35";
    ranksep="0.45";
    fontname="Arial";
    fontsize=12;

    node [
        shape=box,
        style="rounded,filled",
        fontname="Arial",
        fontsize=11,
        margin="0.18,0.12",
        penwidth=1.4,
        color="#334155",
        fillcolor="#F8FAFC",
        fontcolor="#0F172A"
    ];

    edge [
        fontname="Arial",
        fontsize=10,
        color="#475569",
        penwidth=1.3,
        arrowsize=0.8
    ];

    Orig [
        label="Octopus Learning Overview.gh\n(Original Monolithic 117-Node Demo)",
        fillcolor="#E2E8F0",
        color="#1E293B",
        penwidth=1.8
    ];

    subgraph cluster_S1 {
        label="Part 1: Supervised Learning (oSL)";
        fontname="Arial";
        fontsize=12;
        fontcolor="#1E3A8A";
        style="rounded,filled";
        color="#3B82F6";
        fillcolor="#EFF6FF";
        margin=14;

        F1  [label="01_Octopus_Supervised_SVM.gh\n(Supervised: SVM & ANN)", fillcolor="#DBEAFE", color="#1D4ED8", penwidth=1.6];
        Tr1 [label="1. Training Set Generator\n(X_train, Y_train from Graph Mapper)", fillcolor="#FFFFFF", color="#2563EB"];
        M1  [label="2. SVMLearn & NetLearn\n(Train RBF Hyperplane / Neural Weights)", fillcolor="#FFFFFF", color="#2563EB"];
        Ev1 [label="3. SVMEval & EvalN\n(Predict Y_hat on 50 Test X Values)", fillcolor="#FFFFFF", color="#2563EB"];
        V1  [label="4. Visual Output & Readout\n(Quick Graph / 3D Curves & Error Table)", fillcolor="#DCFCE7", color="#15803D"];

        F1 -> Tr1 -> M1 -> Ev1 -> V1;
    }

    subgraph cluster_S2 {
        label="Part 2: Evolutionary Learning (oEL)";
        fontname="Arial";
        fontsize=12;
        fontcolor="#7C2D12";
        style="rounded,filled";
        color="#F97316";
        fillcolor="#FFF7ED";
        margin=14;

        F2   [label="02_Octopus_Evolutionary_NEAT.gh\n(Evolutionary: NEAT Topology Breeding)", fillcolor="#FFEDD5", color="#C2410C", penwidth=1.6];
        Pop2 [label="1. Population of Neural Topologies\n(Breeder oEL with Sine/Cosine Neurons)", fillcolor="#FFFFFF", color="#EA580C"];
        Fit2 [label="2. Fitness Evaluation\n(Sum of Squared Errors vs. Target Curve)", fillcolor="#FFFFFF", color="#EA580C"];
        Gen2 [label="3. Generation Selection & Mutation\n(Add Nodes/Synapses Without Gradients)", fillcolor="#DCFCE7", color="#15803D"];

        F2 -> Pop2 -> Fit2 -> Gen2;
    }

    Orig -> F1;
    Orig -> F2;
}
